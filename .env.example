# Optional: bake the public Google OAuth client ID into the build.
# You can also paste it in the app's Connect Drive dialog at runtime.
VITE_GOOGLE_CLIENT_ID=

# Optional: self-hosted PeerJS signaling server for QR phone signing.
# Leave blank to use the public PeerJS broker.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
